{
  "name": "@drunk-pulumi/azure-components",
  "version": "0.0.1",
  "description": "The custom components for Pulumi Azure",
  "main": "index.js",
  "types": "index.d.ts",
  "pulumi": {
    "resource": false,
    "name": "@drunk-pulumi/azure-components"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baoduy/drunk-pulumi-azure-components.git"
  },
  "scripts": {
    "fastBuild": "cross-env NODE_ENV=production && npx tsc",
    "build": "pnpm run update-tsconfig && pnpm run fastBuild && npm run copy-pkg",
    "copy-pkg": "tsx ./.tasks/npm-package.ts && cpy README.md bin/ && cpy PulumiPlugin.yaml bin/",
    "update-tsconfig": "tsx ./.tasks/update-tsconfig.ts",
    "update": "npx npm-check-updates -u && pnpm install",
    "test": "jest",
    "docs": "tsx ./.tasks/generate-docs.ts"
  },
  "keywords": [],
  "author": "Steven Hoang",
  "license": "MIT",
  "dependencies": {
    "@azure/keyvault-certificates": "^4.10.3",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@drunk-pulumi/azure-providers": "^1.0.17",
    "@pulumi/azure-native": "^3.24.0",
    "@pulumi/azuread": "^6.10.0",
    "@pulumi/pulumi": "^3.257.0",
    "@pulumi/random": "^4.21.1",
    "lodash": "^4.18.1",
    "netmask": "^2.1.1",
    "openpgp": "^6.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/netmask": "^2.0.6",
    "@types/node": "26.2.0",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2
  },
  "packageManager": "pnpm@11.13.1"
}
